#!/usr/bin/env bash
# Every gate, before anything leaves this machine. ~3 minutes.
#
# GitHub Actions runs but cannot be the authority here: one of its five jobs can
# never pass without the 2.4 GB of model weights, so the workflows are disabled
# (docs/KNOWN_ISSUES.md item 11). This hook is the replacement, not a supplement
# to it — and it is free either way, the repository being public. It
# runs scripts/ci-local.sh, which runs the same five jobs .github/workflows/ci.yml
# declares — trust-core, workspace, frontend, python, version-drift — and exits
# non-zero naming every gate that failed. This is the last point at which a
# broken commit is still cheap.
#
# Side effect worth knowing about: ci-local.sh stages dev stub sidecars
# (scripts/dev-stubs.sh), which creates src-tauri/binaries/_placeholder.dll when
# it is absent. scripts/verify-binaries.ps1 refuses to package a release while a
# marked stub is present, so delete that file before a release build.
#
# Bypass, when you mean it (pushing a WIP branch for someone to look at, or a
# machine that cannot run the suite at all):
#   BACKLOG_SKIP_HOOKS=1 git push ...
#   git push --no-verify

set -uo pipefail

if [ "${BACKLOG_SKIP_HOOKS:-0}" != "0" ]; then
  echo "pre-push: skipped (BACKLOG_SKIP_HOOKS=$BACKLOG_SKIP_HOOKS). Nothing checked this push."
  exit 0
fi

cd "$(git rev-parse --show-toplevel)" || exit 1

# git feeds this hook one line per ref: <local ref> <local oid> <remote ref> <remote oid>.
# Read it once into a variable rather than consuming the pipe, because the global-hook
# handoff at the bottom has to replay it — a hook that drains stdin and then execs
# another one hands that one an empty pipe and it silently checks nothing.
pushed_refs="$(cat)"

# Nothing to validate if every ref being pushed is a commit origin already has. That is
# the ordinary `git push origin <tag>` right after pushing the branch: same commit, same
# tree, gates already run. Re-running three minutes of cargo there teaches people to
# reach for --no-verify, and back-to-back runs collide over target/ file locks besides.
needs_gates=0
while read -r _local_ref local_oid _remote_ref _remote_oid; do
  [ -n "${local_oid:-}" ] || continue
  case "$local_oid" in
    *[!0]*) ;;      # a real object
    *) continue ;;  # all-zero oid: a deletion, nothing to check
  esac
  # Empty means no remote-tracking ref reaches it, so it has never been validated here.
  # Stale tracking refs make this err toward running the gates, which is the safe side.
  if [ -z "$(git branch -r --contains "$local_oid" 2>/dev/null)" ]; then
    needs_gates=1
  fi
done <<EOF
$pushed_refs
EOF

if [ "$needs_gates" = "0" ] && [ -n "$pushed_refs" ]; then
  echo "pre-push: nothing new to validate — every ref here is a deletion, or a commit origin already has and the gates ran on it then. Skipping."
else
  echo "pre-push: running every gate (scripts/ci-local.sh, ~3 min). BACKLOG_SKIP_HOOKS=1 skips."
  if ! bash scripts/ci-local.sh; then
  cat <<'EOF' >&2

pre-push: the gates above are what CI would have caught, if CI ran for this
repository; it does not (docs/KNOWN_ISSUES.md item 11), so this hook is the
only thing between a broken commit and the remote.

Re-run one job while you fix it:
  ./scripts/ci-local.sh trust-core     # or: workspace | frontend | python | version-drift

Push anyway, on purpose:
  BACKLOG_SKIP_HOOKS=1 git push ...
  git push --no-verify
EOF
    exit 1
  fi
fi

# A repo-local core.hooksPath supersedes a global one, so any machine-wide hook
# of this name stopped running here the moment install-hooks pointed git at
# .githooks. Hand off to it rather than silently disabling it. No-op on a
# machine with no global core.hooksPath, which is every fresh clone.
global_hooks="$(git config --global --get core.hooksPath || true)"
if [ -n "$global_hooks" ]; then
  global_hook="$global_hooks/$(basename "$0")"
  if [ -x "$global_hook" ] && ! [ "$global_hook" -ef "$0" ]; then
    exec "$global_hook" "$@" <<EOF
$pushed_refs
EOF
  fi
fi
