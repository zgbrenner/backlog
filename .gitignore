# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
.vite/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Tauri sidecar & model binaries (built/downloaded, not committed)
src-tauri/binaries/
src-tauri/portable-inputs/

# Python
__pycache__/
*.py[cod]
.venv/
.venv-build/
venv/
env/
*.egg-info/

# Downloaded model weights (lockfile IS committed; weights are not)
models/**/*.gguf
# The copy the installer bundles. Staged by the release build from the verified
# app-data set; hash-pinned in models/models.lock.json like every other copy.
src-tauri/resources/models/*.gguf
models/**/*.safetensors
models/**/*.bin
models/**/*.onnx
models/**/vocab.txt
src-tauri/resources/models/**/*.onnx
src-tauri/resources/models/**/vocab.txt

# Training artifacts
training/data/
training/ettin-backlog-*/

# Tooling / agent scratch
.omc/
.crux/

# Logs / OS / editor
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Agent worktrees / scratch
.claude/
sidecar/*.spec

# PyInstaller's intermediate build tree. `dist/` above already covers
# sidecar/dist; this is the other half that scripts/build-sidecar.ps1 leaves
# behind (analysis caches, the frozen PKG, warn-convertd.txt).
sidecar/build/

# Browser UI harness output (screenshots + built bundle)
dist-harness/
.venv311/
